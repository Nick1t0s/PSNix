# XP-Pen
# Deco01 v3
#
# sysinfo.uWI7cjQylf.tar.gz
# https://github.com/linuxwacom/wacom-hid-descriptors/issues/468
#
# OVERRIDE системного /usr/share/libwacom/xp-pen-deco01-v3.tablet.
# Имя файла должно совпадать с системным: libwacom пропускает поздние дубликаты
# по имени файла, а повтор DeviceMatch в другом файле = "Duplicate match" = сломанная база.
#
# Зачем: hid-generic не выставляет INPUT_PROP_DIRECT у пера, а без IntegratedIn
# libinput не считает планшет "display tablet" и не устанавливает конфиг калибровки.
# Из-за этого per-device `transform` в Hyprland (calibration matrix) молча
# игнорируется. IntegratedIn=display включает его.
#
# Побочка: Reversible=false (иначе libwacom warning "reversible + display impossible");
# это лишь выключает left_handed-режим пера, который не используется.

[Device]
Name=XP-Pen Deco 01 V3
ModelName=
DeviceMatch=usb|28bd|0947
PairedIDs=
Width=10
Height=6
IntegratedIn=Display
# Looks the same as the v2, so let's re-use the layout
Layout=xp-pen-deco01-v2.svg
Styli=@generic-no-eraser

[Features]
Stylus=true
Reversible=false
Touch=false
TouchSwitch=false
NumRings=0
NumStrips=0

[Buttons]
Left=A;B;C;D;E;F;G;H
EvdevCodes=BTN_0;BTN_1;BTN_2;BTN_3;BTN_4;BTN_5;BTN_6;BTN_7
