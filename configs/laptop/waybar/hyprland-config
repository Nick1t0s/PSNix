{
    "layer": "top",
    "position": "top",
    "output": "eDP-1",

    "height": 42,
    "margin-top": 3,
    "margin-left": 3,
    "margin-right": 3,
    "spacing": 0,

    "modules-left": [
        "custom/menu",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "custom/cpu-temp",
        "memory",
        "cpu"
    ],

    "modules-right": [
        "tray",
        "battery",
        "backlight",
        "pulseaudio",
        "hyprland/language",
        "clock",
        "bluetooth",
        "network",
        "custom/powermenu"
    ],

    "custom/menu": {
        "format": "",
        "tooltip": "Applications",
        "on-click": "wofi --show drun"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by": "number",
        "persistent-workspaces": {
            "*": 9
        }
    },

    "custom/cpu-temp": {
        "exec": "~/.config/waybar/scripts/cpu-temp.sh",
        "interval": 5,
        "format": "  {}°C",
        "tooltip": "CPU Package temperature"
    },

    "memory": {
        "interval": 2,
        "format": "  {used:0.1f}G"
    },

    "cpu": {
        "interval": 2,
        "format": "  {usage}%"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 8
    },

    "battery": {
        "bat": "BAT0",
        "interval": 5,
        "full-at": 98,

        "states": {
            "warning": 20,
            "critical": 10
        },

        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "󰁹 100%",

        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "  {percent}%",
        "tooltip": true,
        "tooltip-format": "Brightness: {percent}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",

        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },

        "tooltip": true,
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "hyprland/language": {
        "format": "  {}",
        "format-en": "EN",
        "format-ru": "RU",
        "tooltip": false
    },

    "clock": {
        "interval": 10,
        "format": "  {:%H:%M}",
        "format-alt": "  {:%d.%m.%Y}",
        "tooltip-format": "<big>{:%A}</big>\n{calendar}"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": "",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "on-click": "~/.local/bin/rofi-bluetooth"
    },

    "network": {
        "interface": "wlp0s20f3",
        "interval": 3,
        "format-wifi": "  {signalStrength}%",
        "format-disconnected": "󰖪  offline",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
        "on-click": "~/.local/bin/rofi-wifi"
    },

    "custom/powermenu": {
        "format": "",
        "tooltip": "Logout",
        "on-click": "hyprctl dispatch exit"
    }
}
